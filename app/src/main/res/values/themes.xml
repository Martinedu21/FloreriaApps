<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌸 Tema principal de la app -->
    <style name="Theme.FloreriaApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/floripondia_pink</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/floripondia_pink</item>
        <item name="colorSecondaryVariant">@color/purple_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Barra de estado -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/purple_700</item>

        <!-- Fondo y texto -->
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>

        <!-- Personalización general -->
        <item name="colorSurface">@color/rose_100</item>
        <item name="colorOnSurface">@color/black</item>
    </style>

    <!-- Versión sin ActionBar -->
    <style name="Theme.FloreriaApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
